# ============================================================
# Runtime
# ============================================================

ENVIRONMENT=production

APP_DOMAIN=drift.example.com
APP_BASE_URL=https://drift.example.com

TLS_EMAIL=ops@example.com


# ============================================================
# Application security
# ============================================================

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Base64-encoded 32-byte key used to encrypt webhook signing secrets.
# Generate and store the real value in the deployment secret store.
SDE_WEBHOOK_SECRET_ENCRYPTION_KEY=

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Caddy connects to Uvicorn over the Docker bridge network.
FORWARDED_ALLOW_IPS=172.16.0.0/12


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=semantic_drift
POSTGRES_USER=semantic_drift
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DATABASE_URL=postgresql://semantic_drift:replace-with-a-strong-database-password@db:5432/semantic_drift

# JSON object mapping non-secret connection references to downstream
# database URLs. Supply real values through the deployment secret store.
SDE_DOWNSTREAM_DATABASE_URLS={}


# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0


# ============================================================
# API runtime
# ============================================================

UVICORN_WORKERS=2


# ============================================================
# OAuth
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ============================================================
# Transactional email
# ============================================================

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

EMAIL_STREAM_KEY=sde:email:stream
EMAIL_STREAM_GROUP=sde-email-workers
EMAIL_DEAD_LETTER_STREAM=sde:email:dead
EMAIL_RETRY_ZSET=sde:email:retry

EMAIL_WORKER_CLAIM_IDLE_MS=120000
EMAIL_WORKER_BLOCK_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_WORKER_RETRY_BASE_SECONDS=5
EMAIL_WORKER_RETRY_MAX_SECONDS=300
EMAIL_WORKER_HTTP_TIMEOUT=20


# ============================================================
# Semantic analysis
# ============================================================

DEEPSEEK_API_KEY=

# Embedding provider
# Supported: openai, gemini
EMBEDDING_PROVIDER=openai

# OpenAI embedding
# Leave OPENAI_EMBEDDING_BASE_URL empty to use the default OpenAI API.
# For an OpenAI-compatible provider, configure its /v1-compatible
# base URL here.
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Gemini embedding
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
