# Application
APP_NAME=Semantic Drift Engine
ENVIRONMENT=development
DEBUG=true
APP_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/semantic_drift

# Downstream execution databases
# Values are runtime secrets. Bindings store only the non-secret connection_ref.
SDE_DOWNSTREAM_DATABASE_URLS={}

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
# Generate a cryptographically secure value before deploying:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Webhook secret encryption
# Generate a dedicated 32-byte AES-256 key and encode it as URL-safe base64:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SDE_WEBHOOK_SECRET_ENCRYPTION_KEY=

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Reverse proxy
# Enable only when the application is behind a trusted reverse proxy that
# overwrites client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Embedding provider
# Supported: openai, gemini
EMBEDDING_PROVIDER=openai

# OpenAI embedding
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Gemini embedding
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Email worker
EMAIL_STREAM_KEY=sde:email:stream
EMAIL_STREAM_GROUP=sde-email-workers
EMAIL_STREAM_MAXLEN=10000
EMAIL_DEAD_LETTER_STREAM=sde:email:dead
EMAIL_RETRY_ZSET=sde:email:retry
EMAIL_WORKER_CLAIM_IDLE_MS=120000
EMAIL_WORKER_BLOCK_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_MAX_ATTEMPTS=5
EMAIL_WORKER_RETRY_BASE_SECONDS=5
EMAIL_WORKER_RETRY_MAX_SECONDS=300
EMAIL_WORKER_HTTP_TIMEOUT=20

# Logging
LOG_LEVEL=INFO

# Continuous crawler scheduler
CRAWLER_SCHEDULER_POLL_SECONDS=5

# Lineage invalidation executor
LINEAGE_INVALIDATION_EXECUTOR_POLL_SECONDS=5

# Vector intelligence worker
VECTOR_WORKER_SNAPSHOT_LIMIT=10
VECTOR_WORKER_EVENT_LIMIT=10
VECTOR_WORKER_RISK_LIMIT=10
VECTOR_WORKER_PATTERN_LIMIT=10
VECTOR_WORKER_ANOMALY_LIMIT=10
VECTOR_WORKER_MAX_ATTEMPTS=3
VECTOR_WORKER_POLL_SECONDS=10

# Worker stage switches
# Embeddings are disabled by default because they require an
# external embedding provider. Downstream deterministic stages
# are enabled by default.
VECTOR_WORKER_EMBEDDINGS_ENABLED=false
VECTOR_WORKER_ANALYSIS_ENABLED=true
VECTOR_WORKER_RISK_SCORING_ENABLED=true
VECTOR_WORKER_PATTERN_DETECTION_ENABLED=true
VECTOR_WORKER_ANOMALY_DETECTION_ENABLED=true